{
  "name": "vscode-showme",
  "private": true,
  "displayName": "ShowMe",
  "description": "Give AI agents hands in VS Code: show, annotate and diagram code alongside a human reader.",
  "version": "0.1.0",
  "preview": true,
  "license": "MIT",
  "publisher": "zvxbase",
  "repository": { "type": "git", "url": "https://github.com/zvxbase/vscode-showme.git" },
  "bugs": { "url": "https://github.com/zvxbase/vscode-showme/issues" },
  "homepage": "https://github.com/zvxbase/vscode-showme#readme",
  "keywords": ["mcp", "agent", "claude code", "copilot", "codex", "code reading", "annotations"],
  "engines": {
    "vscode": "^1.101.0",
    "node": ">=20"
  },
  "extensionKind": ["workspace"],
  "categories": ["AI", "Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "l10n": "./l10n",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "%showme.untrustedWorkspaces.description%",
      "restrictedConfigurations": [
        "showme.enabled",
        "showme.stage.enabled",
        "showme.stage.editorGroup",
        "showme.html.enabled",
        "showme.html.maxPanels",
        "showme.layout.enabled",
        "showme.layout.closeHumanTabs",
        "showme.layout.closeDirtyTabs",
        "showme.redactedPathPatterns",
        "showme.maxSelectionChars",
        "showme.injectTerminalEnv",
        "showme.listAllWorkspaces"
      ]
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "showme.toggle",
        "title": "%showme.command.toggle%"
      },
      {
        "command": "showme.disableExtension",
        "title": "%showme.command.disableExtension%"
      },
      {
        "command": "showme.showAgentConfig",
        "title": "%showme.command.showAgentConfig%"
      },
      {
        "command": "showme.showLog",
        "title": "%showme.command.showLog%"
      },
      {
        "command": "showme.teardown",
        "title": "%showme.command.teardown%"
      },
      {
        "command": "showme.clearHighlights",
        "title": "%showme.command.clearHighlights%"
      },
      {
        "command": "showme.clearAnnotations",
        "title": "%showme.command.clearAnnotations%"
      },
      {
        "command": "showme.annotation.resolve",
        "title": "%showme.command.annotation.resolve%",
        "icon": "$(check)"
      },
      {
        "command": "showme.annotation.unresolve",
        "title": "%showme.command.annotation.unresolve%",
        "icon": "$(debug-restart)"
      },
      {
        "command": "showme.annotation.previous",
        "title": "%showme.command.annotation.previous%",
        "icon": "$(arrow-left)"
      },
      {
        "command": "showme.annotation.next",
        "title": "%showme.command.annotation.next%",
        "icon": "$(arrow-right)"
      }
    ],
    "menus": {
      "comments/commentThread/title": [
        {
          "command": "showme.annotation.previous",
          "when": "commentController == showme.annotations && commentThread =~ /(middle|last)$/",
          "group": "inline@1"
        },
        {
          "command": "showme.annotation.next",
          "when": "commentController == showme.annotations && commentThread =~ /(first|middle)$/",
          "group": "inline@2"
        },
        {
          "command": "showme.annotation.resolve",
          "when": "commentController == showme.annotations && commentThread =~ /^unresolved/",
          "group": "inline@3"
        },
        {
          "command": "showme.annotation.unresolve",
          "when": "commentController == showme.annotations && commentThread =~ /^resolved/",
          "group": "inline@3"
        }
      ],
      "commandPalette": [
        {
          "command": "showme.annotation.resolve",
          "when": "false"
        },
        {
          "command": "showme.annotation.unresolve",
          "when": "false"
        },
        {
          "command": "showme.annotation.previous",
          "when": "false"
        },
        {
          "command": "showme.annotation.next",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "ShowMe",
      "properties": {
        "showme.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%showme.config.enabled%",
          "scope": "machine"
        },
        "showme.stage.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%showme.config.stage.enabled%",
          "scope": "machine"
        },
        "showme.stage.editorGroup": {
          "type": "string",
          "enum": ["dedicated", "active"],
          "default": "dedicated",
          "description": "%showme.config.stage.editorGroup%",
          "scope": "machine"
        },
        "showme.html.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%showme.config.html.enabled%",
          "scope": "machine"
        },
        "showme.html.maxPanels": {
          "type": "integer",
          "minimum": 0,
          "maximum": 999,
          "default": 2,
          "description": "%showme.config.html.maxPanels%",
          "scope": "machine"
        },
        "showme.layout.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%showme.config.layout.enabled%",
          "scope": "machine"
        },
        "showme.layout.closeHumanTabs": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "description": "%showme.config.layout.closeHumanTabs%"
        },
        "showme.layout.closeDirtyTabs": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "description": "%showme.config.layout.closeDirtyTabs%"
        },
        "showme.redactedPathPatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%showme.config.redactedPathPatterns%",
          "scope": "machine"
        },
        "showme.maxSelectionChars": {
          "type": "number",
          "default": 4000,
          "description": "%showme.config.maxSelectionChars%",
          "scope": "machine"
        },
        "showme.injectTerminalEnv": {
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "description": "%showme.config.injectTerminalEnv%"
        },
        "showme.listAllWorkspaces": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "description": "%showme.config.listAllWorkspaces%"
        }
      }
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "showme",
        "label": "%showme.mcp.label%"
      }
    ]
  },
  "scripts": {
    "build": "tsc --build && node esbuild.mjs",
    "vscode:prepublish": "npm run build",
    "package": "node ../../scripts/release/sync-extension-docs.mjs && vsce package --no-dependencies",
    "compile:integration": "tsc --build ../bridge && tsc -p test/integration/tsconfig.json",
    "test:integration": "npm run build && npm run compile:integration && node out-test/runTest.js",
    "test:integration:xvfb": "npm run build && npm run compile:integration && xvfb-run -a --server-args=\"-screen 0 1600x1200x24\" node out-test/runTest.js",
    "test:integration:two-windows": "npm run build && npm run compile:integration && node out-test/runTwoWindows.js",
    "test:integration:two-windows:xvfb": "npm run build && npm run compile:integration && xvfb-run -a --server-args=\"-screen 0 1600x1200x24\" node out-test/runTwoWindows.js",
    "test:integration:locale-ja": "npm run build && npm run compile:integration && node out-test/runLocaleJa.js",
    "test:integration:locale-ja:xvfb": "npm run build && npm run compile:integration && xvfb-run -a --server-args=\"-screen 0 1600x1200x24\" node out-test/runLocaleJa.js"
  },
  "dependencies": {
    "@zvx/vscode-showme-protocol": "*"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/vscode": "^1.138.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "@zvx/vscode-showme-bridge": "*",
    "mocha": "^12.0.2"
  }
}
